{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brd-download",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "brd.spektralab.app", "custom_domain": true }],
  "kv_namespaces": [
    // Per-purchase download counts. Replace the id with the one `wrangler kv namespace create DOWNLOADS` prints.
    { "binding": "DOWNLOADS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "r2_buckets": [
    // Private bucket holding the Pro build. Nothing in it is public; the Worker is the only way in.
    { "binding": "RELEASES", "bucket_name": "brd-releases" }
  ],
  "vars": {
    // Stripe Payment Link that sells Pro. Its "after payment" redirect must be
    // https://brd.spektralab.app/thanks?session_id={CHECKOUT_SESSION_ID}
    "PAYMENT_LINK_URL": "https://buy.stripe.com/REPLACE_ME",
    // Optional: the link's id (plink_...). When set, payments made through any other link are refused.
    "PAYMENT_LINK_ID": "",
    "RELEASE_KEY": "BetterRemoteDisplay-Pro.zip",
    "MAX_DOWNLOADS": "3",
    "LINK_VALID_DAYS": "7"
  }
  // Secret, set with `wrangler secret put STRIPE_SECRET_KEY`: a restricted key with read access to Checkout Sessions.
}
